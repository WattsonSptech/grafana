          "format": 1,
          "rawSQL": "WITH ContagemEventos AS (\n    SELECT\n        SUM(CASE WHEN tensao_valor > $max_tensao OR tensao_valor < $min_tensao THEN 1 ELSE 0 END) AS OcorrsTensao,\n        data_hora_geracao,\n        clima_vento\n        \n    FROM tensao_clima\n    WHERE zona_geracao IN($zonas)\n    GROUP BY data_hora_geracao, clima_vento\n)\n\nSELECT\n    CAST(SUM(OcorrsTensao) AS DOUBLE) / COUNT(CASE WHEN clima_vento > 7.0 THEN 1 END) AS OcorrenciasPorEvento\nFROM ContagemEventos WHERE clima_vento > 7.0;",
          "refId": "A"
        }
