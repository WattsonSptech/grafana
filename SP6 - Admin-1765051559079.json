          },
          "format": 1,
          "rawSQL": "WITH duracao_falha_zona AS (\n  WITH occors_h AS (\n    WITH t AS (\n      SELECT AVG(tensao_valor) AS tensao, zona_geracao, data_hora_geracao\n      FROM tensao_clima\n      WHERE zona_geracao IN($zonas)\n      GROUP BY zona_geracao, data_hora_geracao\n    )\n    SELECT\n        data_hora_geracao, zona_geracao, SUM(CASE WHEN t.tensao >= $max_tensao THEN 1 ELSE 0 END) + \n        SUM(CASE WHEN t.tensao <= $min_tensao THEN 1 ELSE 0 END) AS ocorrs\n    FROM t\n    GROUP BY data_hora_geracao, zona_geracao\n  )\n  SELECT \n  day(data_hora_geracao) as dia,\n  date_diff(\n    'hour',\n    min(data_hora_geracao),\n    max(data_hora_geracao)\n  ) AS duracao, zona_geracao \n  FROM occors_h WHERE ocorrs >= 1\n  GROUP BY day(data_hora_geracao), zona_geracao\n)\nSELECT MAX(duracao) as \"Máximo\", AVG(duracao) as \"Média\", MIN(duracao) as \"Mínimo\" FROM duracao_falha_zona\nWHERE duracao > 0;",
          "refId": "A"
        }
      ],
