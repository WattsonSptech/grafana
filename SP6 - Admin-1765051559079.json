          },
          "format": 1,
          "rawSQL": "WITH t AS (\n  SELECT AVG(tensao_valor) AS tensao, zona_geracao\n  FROM tensao_clima\n  GROUP BY zona_geracao, data_hora_geracao\n)\nSELECT\n  SUM(CASE WHEN t.tensao >= $max_tensao THEN 1 ELSE 0 END) AS \"Alta tensão\",\n  SUM(CASE WHEN t.tensao <= $min_tensao THEN 1 ELSE 0 END) AS \"Baixa tensão\",\n  pop.zona_geracao,\n  pop.populacao\nFROM t JOIN (\n  VALUES\n    ('NORTE', 2.7),\n    ('NORDESTE', 1.3),\n    ('LESTE', 4.3),\n    ('SUDESTE', 1.5),\n    ('SUL', 2.8),\n    ('OESTE', 1.9),\n    ('CENTRO', 2.1)\n) AS pop (zona_geracao, populacao) ON t.zona_geracao = pop.zona_geracao\nWHERE pop.zona_geracao IN($zonas)\nGROUP BY pop.zona_geracao, pop.populacao\nORDER BY pop.zona_geracao;",
          "refId": "A"
        }
      ],
      "title": "Ocorrências x População",
