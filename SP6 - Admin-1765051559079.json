          "format": 1,
          "rawSQL": "WITH falhas_por_dia AS (\n  WITH t AS (\n    SELECT AVG(tensao_valor) AS tensao, data_hora_geracao, zona_geracao\n    FROM tensao_clima \n    WHERE zona_geracao IN($zonas)\n    GROUP BY zona_geracao, data_hora_geracao\n  )\n  SELECT \n    COUNT(*) as falhas, day(data_hora_geracao) as dia\n  FROM t \n  WHERE t.tensao >= $max_tensao OR t.tensao <= $min_tensao\n  GROUP BY day(data_hora_geracao)\n)\nSELECT MAX(falhas) AS \"Máximo\", AVG(falhas) AS \"Média\", MIN(falhas) AS \"Mínimo\" FROM falhas_por_dia;",
          "refId": "A"
        }
